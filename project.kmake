//Build script for use with kalamake. Read more at https://github.com/kalakit/kalamake

#version 2.0

#references
name_bin: "kalamake"
dir_release: "build/temp/release-"
dir_debug: "build/temp/debug-"
name_kc: "kalacli"
comm_objcopy: "objcopy --remove-section .note.gnu.property"
links_win:
    "msvcrt",
    "msvcprt",
    "ucrt",
    "vcruntime",
    "shell32",
    "user32"

#global
compilerlauncher: "ccache"
compiler: "clang++"
standard: "c++20"
binarytype: "executable"
binaryname: "${name_bin}"
sources: "src"
headers: "include", "external/kalaheaders/include", "external/kalacli/include"
defines: "LIB_STATIC"
warninglevel: "normal"
customflags: "export-compile-commands", "export-vscode-sln"

#profile debug-windows
buildtype: "debug"
buildpath: "${dir_debug}windows"
links: "external/kalacli/${name_kc}d.lib", "${links_win}"

#profile release-windows
buildtype: "minsizerel"
buildpath: "${dir_release}windows"
links: "external/kalacli/${name_kc}.lib", "${links_win}"

#profile debug-linux
buildtype: "debug"
buildpath: "${dir_debug}linux"
links: "external/kalacli/lib${name_kc}d.a"
postbuildaction:
    //strips stupid avx requirements that cachyos seems to add for no reason
    "${comm_objcopy} ${dir_debug}linux/${name_bin}"

#profile release-linux
buildtype: "minsizerel"
buildpath: "${dir_release}linux"
links: "external/kalacli/lib${name_kc}.a"
postbuildaction:
    //strips stupid avx requirements that cachyos seems to add for no reason
    "${comm_objcopy} ${dir_release}linux/${name_bin}"
postbuildaction:
    "strip --strip-unneeded ${dir_release}linux/${name_bin}"
